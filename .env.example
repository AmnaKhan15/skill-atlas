# Copy this file to .env and fill in the values from your CognoDB Cloud
# instance (console.cognodb.com). Never commit the real .env file.

# Looks like: bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_URI=

# The CognoDB user is always "cognodb"
COGNODB_USER=cognodb

# The password is shown exactly once when you create the instance.
COGNODB_PASSWORD=

# Usually "neo4j" unless you created a different database name.
COGNODB_DATABASE=neo4j

# Comma-separated list of origins allowed to call the API in dev.
CORS_ORIGINS=http://localhost:5173
